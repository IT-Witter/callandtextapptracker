# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Airtable personal access token.
# Create at https://airtable.com/create/tokens with these scopes:
#   data.records:read, data.records:write, schema.bases:read
# and access to the "whatnot username tracker" base.
AIRTABLE_TOKEN=pat_your_token_here

# Shared PIN the team types before picking their name. Any length; digits are easiest on mobile.
APP_PIN=1234

# Random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
